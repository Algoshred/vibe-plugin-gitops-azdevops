{
  "name": "@vibecontrols/vibe-plugin-gitops-azdevops",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "description": "Azure DevOps provider for VibeControls GitOps meta plugin (REST 7.1)",
  "engines": {
    "bun": ">=1.4.4"
  },
  "author": {
    "name": "Vignesh T.V",
    "url": "https://github.com/tvvignesh"
  },
  "license": "MIT",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify-syntax --minify-whitespace --external elysia && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "type:check": "boff gate -- bun check --no-pretty",
    "test": "bun test",
    "clean": "rimraf dist",
    "prebuild": "bun run clean",
    "prepublishOnly": "bun run build",
    "sanity": "boff sanity",
    "sanity:force": "boff sanity --force",
    "audit": "bun audit --audit-level=high"
  },
  "dependencies": {
    "@vibecontrols/plugin-sdk": "2026.522.1",
    "elysia": "^1.4.28"
  },
  "devDependencies": {
    "@burdenoff/toolchain": "2026.1107.14",
    "@types/bun": "^1.4.4",
    "eslint": "^9.39.5",
    "knip": "^6.44.1",
    "rimraf": "^6.1.4",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@vibecontrols/agent": ">=2.0.0",
    "@vibecontrols/vibe-plugin-gitops": ">=0.0.0"
  },
  "peerDependenciesMeta": {
    "@vibecontrols/agent": {
      "optional": true
    },
    "@vibecontrols/vibe-plugin-gitops": {
      "optional": true
    }
  },
  "keywords": [
    "vibecontrols",
    "vibe-plugin",
    "gitops",
    "azure-devops",
    "ci",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Algoshred/vibe-plugin-gitops-azdevops.git"
  },
  "bugs": {
    "url": "https://github.com/Algoshred/vibe-plugin-gitops-azdevops/issues"
  },
  "homepage": "https://vibecontrols.com",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.4.4",
  "boff": {
    "type": "plugin",
    "sanity": {
      "steps": [
        "format",
        "lint",
        "typecheck",
        "build",
        "test",
        "knip"
      ]
    }
  }
}
